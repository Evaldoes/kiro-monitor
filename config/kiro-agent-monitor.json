{
  "name": "monitor",
  "description": "Agente padrão com monitoramento (kiro-monitor)",
  "tools": ["*"],
  "allowedTools": [],
  "resources": [],
  "includeMcpJson": true,
  "hooks": {
    "agentSpawn":       [{"command": "__HOME__/.kiro-monitor/bin/kmon-hook kiro agentSpawn"}],
    "userPromptSubmit": [{"command": "__HOME__/.kiro-monitor/bin/kmon-hook kiro userPromptSubmit"}],
    "preToolUse":       [{"matcher": "*", "command": "__HOME__/.kiro-monitor/bin/kmon-hook kiro preToolUse"}],
    "postToolUse":      [{"matcher": "*", "command": "__HOME__/.kiro-monitor/bin/kmon-hook kiro postToolUse"}],
    "stop":             [{"command": "__HOME__/.kiro-monitor/bin/kmon-hook kiro stop"}]
  }
}
