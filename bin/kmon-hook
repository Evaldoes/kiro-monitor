#!/usr/bin/env python3
"""Hook genérico: kmon-hook <origem> <evento>. Lê JSON do stdin, grava evento e bloqueia comandos perigosos."""
import json, os, re, sys, time
LOG = os.path.expanduser("~/.kiro-monitor/events.jsonl")
DANGER = [r"\brm\s+-[a-z]*r[a-z]*f", r"\brm\s+-[a-z]*f[a-z]*r", r"git\s+push\s+.*(--force|-f\b)",
          r"\bmkfs\b", r"\bdd\s+if=", r":\(\)\s*\{", r"git\s+reset\s+--hard", r"chmod\s+-R\s+777\s+/"]
src, ev = sys.argv[1], sys.argv[2]
raw = sys.stdin.read()
try: data = json.loads(raw)
except Exception: data = {"raw": raw}
tin = data.get("tool_input") or {}
text = json.dumps(tin, ensure_ascii=False)
# No Claude, só interessa o que envolve o kiro
if src == "claude" and "kiro" not in text:
    sys.exit(0)
rec = {"ts": time.time(), "layer": "claude" if src == "claude" else "kiro-hook", "event": ev,
       "tool": data.get("tool_name"), "cwd": data.get("cwd"), "input": tin,
       "response": data.get("tool_response"), "prompt": data.get("prompt"), "session": data.get("session_id")}
blocked = ev.lower() == "pretooluse" and next((p for p in DANGER if re.search(p, text)), None)
if blocked: rec["blocked"] = blocked
with open(LOG, "a") as f: f.write(json.dumps({k: v for k, v in rec.items() if v is not None}, ensure_ascii=False, default=str) + "\n")
if blocked:
    print(f"[kiro-monitor] comando bloqueado (padrão perigoso: {blocked})", file=sys.stderr)
    sys.exit(2)
