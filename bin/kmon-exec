#!/usr/bin/env python3
"""Roda execsnoop (eBPF, precisa de root) e registra só processos descendentes do kiro-cli."""
import json, os, subprocess, time
LOG = os.path.join(os.environ.get("KMON_HOME", os.path.expanduser("~/.kiro-monitor")), "events.jsonl")
tracked = set()
def ancestry_has_kiro(pid):
    for _ in range(30):
        if pid in tracked: return True
        try:
            comm = open(f"/proc/{pid}/comm").read().strip()
            if comm.startswith("kiro"): return True
            pid = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
        except Exception: return False
        if pid <= 1: return False
    return False
p = subprocess.Popen(["execsnoop-bpfcc", "-T", "-x"], stdout=subprocess.PIPE, text=True, bufsize=1)
next(p.stdout)  # cabeçalho
for line in p.stdout:
    parts = line.split(None, 5)
    if len(parts) < 6: continue
    _, comm, pid, ppid, ret, args = parts
    pid, ppid = int(pid), int(ppid)
    if comm.startswith("kiro") or ppid in tracked or ancestry_has_kiro(ppid):
        tracked.add(pid)
        with open(LOG, "a") as f:
            f.write(json.dumps({"ts": time.time(), "layer": "os-exec", "event": "exec", "pid": pid,
                "ppid": ppid, "comm": comm, "ret": int(ret), "args": args.strip()}) + "\n")
